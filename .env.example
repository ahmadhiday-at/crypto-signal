# Server settings and secrets only. Markets, timeframes, weights, signal model and the other
# calculation values live in config/calculation.json: edit that file or use /config.

# Server
PORT=11000
# Interface for local runs (default 0.0.0.0 = all interfaces). Docker Compose forces 0.0.0.0 inside
# the container and uses BIND_ADDR below instead.
HOST=127.0.0.1
# Docker Compose only: host interface the port is published on.
BIND_ADDR=127.0.0.1
# Token for config save, backtest run and reset (at least 16 characters). Empty = those actions are refused.
# Generate one with: openssl rand -hex 32
ADMIN_TOKEN=
# Extra host names the server answers to, besides localhost / 127.0.0.1 / [::1] (comma separated).
# Needed when opening the app via a LAN IP or host name, e.g. ALLOWED_HOSTS=192.168.1.20
ALLOWED_HOSTS=

# Optional Binance endpoints (defaults shown).
# BINANCE_REST_URL=https://api.binance.com
# BINANCE_WS_URL=wss://stream.binance.com:9443/ws
