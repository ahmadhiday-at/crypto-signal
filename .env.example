# Server Configuration
PORT=11000

# Market Settings
# List of markets to track (comma separated)
MARKET_LIST=BTCUSDT,BNBUSDT,SOLUSDT

# Timeframe Settings
# List of timeframes to track (comma separated)
TIMEFRAME_LIST=1m,5m,15m,30m,1h,4h,1d,1w
# Labels for timeframes (comma separated, order must match TIMEFRAME_LIST)
TIMEFRAME_LABELS=1m,5m,15m,30m,1h,4h,1d,1w

# Candle Mapping (used for adaptive lookback)
# Format: timeframe:candles,timeframe:candles
MAPPING_CANDLE=1m:500,15m:200,1h:200,4h:200,1d:200

# --- MULTI-TIMEFRAME ENGINE ---
# Role Mapping
TF_HTF=1d
TF_STRUCTURE=4h
TF_MID=1h
TF_ENTRY=15m

# Weighting for Merged Levels
WEIGHT_1D=3.0
WEIGHT_4H=2.0
WEIGHT_1H=1.5
WEIGHT_15M=1.0

DEFAULT_MARKET=BTCUSDT
DEFAULT_TIMEFRAME=15m
CANDLE_LIMIT=1000
TIMEFRAME_LIST=1w,1d,4h,1h,30m,15m,1m
TIMEFRAME_LABELS=1 Week,1 Day,4 Hour,1 Hour,30 Minute,15 Minute,1 Minute
MAPPING_CANDLE=1M:120,1W:200,1D:250,12H:300,8H:300,4H:300,2H:250,1H:200,30m:300,15m:300,10m:300,5m:300,3m:400,1m:500
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_URL=https://api.binance.com
LOG_LEVEL=info

