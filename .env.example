# Server Configuration
PORT=11000
# Interface the Node.js server listens on for local runs (default 0.0.0.0 = all interfaces).
# 127.0.0.1 keeps it local. Docker Compose overrides this with 0.0.0.0 inside the container.
HOST=127.0.0.1
# Docker Compose only: host interface the port is published on (default 127.0.0.1).
BIND_ADDR=127.0.0.1
# Extra host names the server answers to, besides localhost / 127.0.0.1 / [::1] (comma separated).
# Needed when opening the app via a LAN IP or host name, e.g. ALLOWED_HOSTS=192.168.1.20
ALLOWED_HOSTS=

# Market Settings
# List of markets to track (comma separated)
MARKET_LIST=BTCUSDT,BNBUSDT,SOLUSDT

# Timeframe Settings
# List of timeframes to track (comma separated)
TIMEFRAME_LIST=1w,1d,4h,1h,30m,15m,1m
# Labels for timeframes (comma separated, order must match TIMEFRAME_LIST)
TIMEFRAME_LABELS=1 Week,1 Day,4 Hour,1 Hour,30 Minute,15 Minute,1 Minute

# Candle Mapping (used for adaptive lookback)
# Format: timeframe:candles,timeframe:candles
# Keys must match TIMEFRAME_LIST codes exactly (case-sensitive, e.g. 1h, 4h, 1d, 1w).
# Upper-case keys such as 1H/4H/1D/1W below never match, so those timeframes use the default 200.
MAPPING_CANDLE=1M:120,1W:200,1D:250,12H:300,8H:300,4H:300,2H:250,1H:200,30m:300,15m:300,10m:300,5m:300,3m:400,1m:500

# --- MULTI-TIMEFRAME ENGINE ---
# Role Mapping
TF_HTF=1d
TF_STRUCTURE=4h
TF_MID=1h
TF_ENTRY=15m

# Weighting for Merged Levels
WEIGHT_1D=3.0
WEIGHT_4H=2.0
WEIGHT_1H=1.5
WEIGHT_15M=1.0
# Also supported (default 1.0): WEIGHT_1W, WEIGHT_1M (1-minute). Other timeframes use 1.0.
# WEIGHT_1W=1.0
# WEIGHT_1M=1.0

# Not read by the application code (kept for reference).
DEFAULT_MARKET=BTCUSDT
DEFAULT_TIMEFRAME=15m
# Candles fetched per timeframe; must be 201-1000, otherwise 500 is used.
CANDLE_LIMIT=1000
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_REST_URL=https://api.binance.com
# Not read by the application code (kept for reference).
LOG_LEVEL=info

